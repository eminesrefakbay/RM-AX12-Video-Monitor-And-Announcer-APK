<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app theme: no title bar, the logo screen as the window background so there is no white flash at start,
         and one dark look for every button and every dialog. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#4FC3F7</item>
        <item name="android:buttonStyle">@style/AxButton</item>
        <item name="android:alertDialogTheme">@style/AxDialog</item>
    </style>

    <!-- Flat dark buttons with rounded corners: the same everywhere (panels, menus, dialogs). -->
    <style name="AxButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/ax_button_bg</item>
        <item name="android:textColor">@color/ax_button_text</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">64dp</item>
    </style>

    <!-- Every dialog: dark rounded window, white text; the buttons get the light blue accent colour from the theme. -->
    <style name="AxDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/ax_dialog_bg</item>
        <item name="android:colorBackground">#1A222C</item>
        <item name="android:colorAccent">#4FC3F7</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0BEC5</item>
    </style>
</resources>
