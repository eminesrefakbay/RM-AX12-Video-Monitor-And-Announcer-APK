<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/rulesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rulesHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#BDBDBD"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/rulesEdit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#2B2B2B"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/rulesInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:paddingTop="6dp"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnCheck" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/btnSave" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/btnSample" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/btnClose" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
