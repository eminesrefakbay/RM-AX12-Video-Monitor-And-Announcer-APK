<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen video. A grey "No video" screen sits on top when no frames arrive. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <TextureView
        android:id="@+id/texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- No video: a plain grey screen; the icon and the message are added by NoVideoView, a quiet detail line sits along the bottom. -->
    <FrameLayout
        android:id="@+id/noFeed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF3A3A3A">

        <TextView
            android:id="@+id/noFeedDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#FF1E1E1E"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingBottom="6dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- Channel read-out, only used while the test panel is open. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="#80000000"
        android:padding="6dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Every variable the rules can use, with its live value (MENU > Show variables). -->
    <ScrollView
        android:id="@+id/varsPanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginTop="56dp"
        android:background="#C0000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/varsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:typeface="monospace" />
    </ScrollView>

    <Button
        android:id="@+id/menuButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:alpha="0.6"
        android:text="@null" />

    <!-- Test channels: sliders that stand in for the radio while you design the rules. -->
    <ScrollView
        android:id="@+id/testPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="56dp"
        android:background="#B0000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/testList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>
</FrameLayout>
